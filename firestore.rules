// Copy and paste this into Firebase Console -> Firestore Database -> Rules tab, then click Publish:

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /essays/{id} {
      allow read, create, update: if true;
    }
  }
}

